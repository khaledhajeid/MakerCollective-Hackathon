{
  "name": "@mc/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=development --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --conditions=development --env-file-if-exists=../../.env src/db/seed.ts",
    "db:seed:dev": "tsx --conditions=development --env-file-if-exists=../../.env src/db/seed.ts --dev",
    "ops:display": "tsx --conditions=development --env-file-if-exists=../../.env src/cli/display.ts",
    "ops:results": "tsx --conditions=development --env-file-if-exists=../../.env src/cli/results.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/type-provider-zod": "1.0.0",
    "@mc/shared": "workspace:*",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "fastify-plugin": "6.0.0",
    "ioredis": "6.0.0",
    "libphonenumber-js": "1.13.14",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
