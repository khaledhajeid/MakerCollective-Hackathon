  "narrative": {
    "northStar": "The Workshop Banner",
    "overview": "One brand world expressed twice: a premium native-app feel on the phone (navy hero, light navy-tinted canvas, thumb-sized purple button, bottom sheet) and a poster-scale navy ground on the hall TV with yellow reserved for the leader. Depth is soft and navy-tinted; motion is crisp; Arabic is first-class and everything is built RTL first.",
    "keyCharacteristics": [
      "Navy-tinted neutrals; no pure grey or black text.",
      "Brand hues are few and saturated; soft tints carry state.",
      "Purple is voter action; yellow is TV leader; turquoise means yours, live or progress.",
      "Pattern motifs (chevron, dotted gear, rings, triangle, circle) are the only decoration.",
      "Two variants share tokens, fonts and motifs: voter and TV (1920x1080 artboard)."
    ],
    "rules": [
      {
        "name": "The Never-On-White Rule",
        "body": "Yellow and turquoise are never text on white or on canvas. On those fills the text is navy. Purple, royal and crimson carry white text.",
        "section": "colors"
      },
      {
        "name": "The Leader-Only Yellow Rule",
        "body": "On the TV, yellow marks the leading exhibitor and the winner and nothing else; turquoise means liveness only; category colour appears only as the chevron beside the name.",
        "section": "colors"
      },
      {
        "name": "The Tinted-Neutral Rule",
        "body": "Greys are navy-tinted. Shadows are navy-tinted rgba, never black.",
        "section": "colors"
      },
      {
        "name": "The Both-Scripts Rule",
        "body": "Arabic letter-spacing is always 0 and Arabic lines get more leading; Arabic display and title drop to Bold.",
        "section": "typography"
      },
      {
        "name": "The Arabic-Above Rule",
        "body": "On the TV, Arabic is large and primary with English smaller beneath in its own LTR span, hanging from the same right edge.",
        "section": "typography"
      },
      {
        "name": "The Navy-Shadow Rule",
        "body": "Shadows are navy-tinted at low alpha and long blur. No hard offset shadows, no black drops.",
        "section": "elevation"
      },
      {
        "name": "The Flat-TV Rule",
        "body": "The TV expresses hierarchy by fill and scale, not shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do put the primary action in the thumb zone as a 56px purple (or on-dark white) button with press scale and haptic.",
      "Do use navy text on yellow and turquoise fills; white on purple, royal and crimson.",
      "Do keep yellow on the TV for the leader and winner only, and turquoise for liveness and progress.",
      "Do write every error and refusal so it says what happened and what to do next.",
      "Do keep TV text at 40px or more, names at 56px or more, and counts at 72px (leader 96px) or more.",
      "Do keep Western digits and isolate numbers inside Arabic text.",
      "Do animate only transform and opacity, with a reduced-motion alternative.",
      "Do use the shared motifs as the only decoration, and the no-photo tile for missing images."
    ],
    "donts": [
      "Don't set yellow or turquoise text on white or canvas.",
      "Don't add letter-spacing to Arabic, or use fluid type on the voter app.",
      "Don't introduce new brand hues; extend with tints of the six brand colours only.",
      "Don't use gradient text, confetti, glass cards, or hard offset shadows.",
      "Don't show \"voted\" before the server confirms.",
      "Don't let the TV hide or invent numbers: the server decides what is sealed."
    ]
  }
}
