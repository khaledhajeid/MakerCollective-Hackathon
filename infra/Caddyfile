# Edge for the MC2026 stack. TLS is terminated by the tunnel (Cloudflare named tunnel; ngrok fallback);
# Caddy listens on plain HTTP inside the Docker network only.
{
	admin off
	servers {
		# Only the tunnel connectors (cloudflared .11, ngrok fallback .12) may tell us the client IP.
		# - X-Forwarded-For ONLY, parsed strictly right-to-left: both Cloudflare and ngrok APPEND the
		#   address that connected to them, so the right-most untrusted entry is the real client
		#   regardless of what the client pre-filled.
		# - Never read CF-Connecting-IP / X-Real-IP / True-Client-IP: on the ngrok path they pass
		#   through from the client untouched (Phase 1 review, S-7).
		trusted_proxies static 172.28.0.11 172.28.0.12
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

:80 {
	encode zstd gzip

	# Readiness reveals which dependency is down (database / Redis): internal use only, never through the tunnel (R-1).
	handle /api/readyz {
		respond "Not found" 404
	}

	handle /api/* {
		reverse_proxy api1:3000 api2:3000 {
			lb_policy round_robin
			lb_try_duration 3s
			fail_duration 10s
			health_uri /api/healthz
			health_interval 5s
			# Overwrite (not append) with the client IP Caddy resolved above;
			# the API trusts X-Forwarded-For from Caddy's fixed address only.
			header_up X-Forwarded-For {client_ip}
			# SSE: stream immediately, never buffer.
			flush_interval -1
		}
	}

	handle {
		root * /srv
		@assets path /assets/* /fonts/* /brand/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
		@html not path /assets/* /fonts/* /brand/*
		header @html Cache-Control "no-cache"
	}

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		Strict-Transport-Security "max-age=63072000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}
}
