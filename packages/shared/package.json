{
  "name": "@mc/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./digits": {
      "types": "./src/digits.ts",
      "development": "./src/digits.ts",
      "default": "./dist/digits.js"
    },
    "./constants": {
      "types": "./src/constants.ts",
      "development": "./src/constants.ts",
      "default": "./dist/constants.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
